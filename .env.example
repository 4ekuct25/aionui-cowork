# aionui-cowork environment template.
# Copy to .env, then edit. Anything in this file is consumed by
# docker-compose.yml (env_file).

# --------------------------------------------------------------------------
# Container images. Pin to a sha tag in production.
# --------------------------------------------------------------------------
CONTROL_PLANE_IMAGE=ghcr.io/4ekuct25/aionui-cowork-control-plane:dev
SESSION_RUNTIME_IMAGE=ghcr.io/4ekuct25/aionui-cowork-runtime:dev

# Port the control-plane exposes on the host.
APP_PORT=3000

# --------------------------------------------------------------------------
# Auth + tenancy
# --------------------------------------------------------------------------
# Allow public local signup (POST /api/auth/register). First registered user
# is promoted to admin automatically; subsequent users get role='user'.
# Set to "false" if you provision accounts via OIDC only.
ENABLE_LOCAL_SIGNUP=true

# 32-char secret used by tiny-csrf (AES-256-CBC). Generate with:
#   openssl rand -hex 16
CSRF_SECRET=__replace_with_32_char_hex_string__

# 64-hex-char (32-byte) key used by SecretsService to encrypt per-user API
# keys at rest with AES-256-GCM. REQUIRED before users can store any
# OpenAI/Anthropic/custom credentials. Generate with:
#   openssl rand -hex 32
# Rotating this value invalidates every existing secret — keep it stable.
KMS_KEY=__replace_with_64_char_hex_string__

# --------------------------------------------------------------------------
# OIDC (Keycloak / Auth0 / Okta / …). Leave empty to disable SSO.
# When ALL five OIDC_* values are set the SSO button appears on /login.
# --------------------------------------------------------------------------
# OIDC_ISSUER_URL=https://keycloak.example.com/realms/aionui
# OIDC_CLIENT_ID=aionui-cowork
# OIDC_CLIENT_SECRET=__replace__
# OIDC_REDIRECT_URI=https://aionui.example.com/api/auth/oidc/callback
# OIDC_STATE_SECRET=__random_hex_at_least_32_chars__
# OIDC_SCOPES=openid email profile
# OIDC_AUTOPROVISION=true

# --------------------------------------------------------------------------
# Session container resource caps. Applied per-conversation sandbox.
# Defaults baked into DockerSessionManager: 1 GiB memory, 512 CPU shares,
# 512 pids. Override here if your VM is small (or huge).
# --------------------------------------------------------------------------
# SESSION_MEMORY_BYTES=1073741824
# SESSION_CPU_SHARES=512
# SESSION_PIDS_LIMIT=512

# --------------------------------------------------------------------------
# Storage layout (inside the app container — DATA_DIR is fixed to /data via
# compose). Listed for reference only; mutating these requires editing
# docker-compose.yml.
# --------------------------------------------------------------------------
# DATA_DIR=/data        # SQLite + /data/uploads/<projectId>.zip
