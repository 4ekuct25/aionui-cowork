# Session runtime image — per-chat-session sandbox where agents and workers run.
# Contains only language runtimes + base utilities. Individual CLI agents
# (claude-code, gemini-cli, codex, …) are installed lazily on first use into a
# shared cache volume mounted by the control-plane.
#
# Image arch: built multi-arch (amd64 + arm64) via buildx.
# Published as: ghcr.io/4ekuct25/aionui-cowork-runtime:<version>

# ---------------------------------------------------------------------------
# Stage 1: build the worker bundle that DockerPlatformServices.worker.fork
# expects to find under /opt/aionui/dist-server. We reuse the upstream
# scripts/build-server.mjs so the worker entry points (gemini.js, …) stay
# in sync with the control-plane build.
# ---------------------------------------------------------------------------
FROM oven/bun:1.3.14 AS builder
WORKDIR /app

# Cache deps separately from source so changes to src/ don't bust the install
# layer. bun.lock is regenerated in CI when package.json changes.
COPY package.json bun.lock ./
COPY patches/ ./patches/
RUN bun install --ignore-scripts

# Bring in just what scripts/build-server.mjs needs — keeps the build layer
# from churning whenever unrelated parts of the tree change.
COPY tsconfig.json electron.vite.config.ts ./
COPY scripts/ ./scripts/
COPY src/ ./src/

# Produce dist-server/{server.mjs,gemini.js,wasm/,skills/}.
RUN node scripts/build-server.mjs

# ---------------------------------------------------------------------------
# Stage 1b: pluck the aionrs binary out of the upstream Electron release.
# Isolated so curl + dpkg don't pollute the runtime image, and so BuildKit
# can cache the download independently of source changes.
# ---------------------------------------------------------------------------
FROM debian:bookworm-slim AS aionrs-extractor
ARG AIONUI_RELEASE=v1.9.25
ARG TARGETARCH
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates dpkg \
    && rm -rf /var/lib/apt/lists/* \
    && case "$TARGETARCH" in \
         amd64) DEB_ARCH=amd64; BIN_DIR=linux-x64 ;; \
         arm64) DEB_ARCH=arm64; BIN_DIR=linux-arm64 ;; \
         *) echo "Unsupported TARGETARCH=$TARGETARCH" && exit 1 ;; \
       esac \
    && VERSION="${AIONUI_RELEASE#v}" \
    && curl -fsSL -o /tmp/aionui.deb \
        "https://github.com/iOfficeAI/AionUi/releases/download/${AIONUI_RELEASE}/AionUi-${VERSION}-linux-${DEB_ARCH}.deb" \
    && dpkg-deb -x /tmp/aionui.deb /tmp/extract \
    && cp "/tmp/extract/opt/AionUi/resources/bundled-aionrs/${BIN_DIR}/aionrs" /aionrs \
    && chmod +x /aionrs \
    && rm -rf /tmp/aionui.deb /tmp/extract

# ---------------------------------------------------------------------------
# Stage 2: slim runtime that the control-plane exec's into.
# ---------------------------------------------------------------------------
FROM node:20-bookworm-slim

ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 \
      python3-pip \
      python3-venv \
      git \
      curl \
      ca-certificates \
      ripgrep \
      jq \
      tar \
      gzip \
      unzip \
      tini \
    && rm -rf /var/lib/apt/lists/*

# Bun (used by some agents and for general JS scripting)
RUN curl -fsSL https://bun.sh/install | bash -s "bun-v1.3.14" \
    && ln -s /root/.bun/bin/bun /usr/local/bin/bun

# Non-root user for session work
RUN groupadd --gid 10001 aionui \
    && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash aionui \
    && mkdir -p /workspace /opt/aionui \
    && chown -R aionui:aionui /workspace /opt/aionui /home/aionui

# aionrs binary, plucked from the upstream Electron release in the
# extractor stage above. binaryResolver returns this exact path when
# AIONUI_PLATFORM=docker, so renaming requires touching that resolver too.
COPY --from=aionrs-extractor --chown=aionui:aionui /aionrs /opt/aionui/aionrs

COPY resources/container-bootstrap/ /opt/aionui/bootstrap/
RUN chmod +x /opt/aionui/bootstrap/entrypoint.sh \
    && ln -s /opt/aionui/bootstrap/entrypoint.sh /usr/local/bin/aionui-entrypoint

# Worker bundle from stage 1. DockerPlatformServices resolves worker paths
# under /opt/aionui/dist-server, so the layout must match what
# scripts/build-server.mjs emits.
COPY --from=builder --chown=aionui:aionui /app/dist-server /opt/aionui/dist-server

# Bake popular ACP-compatible CLIs so spawnAgentProcess can `docker exec`
# them without a lazy npm install on first use. Mirrors what's in the
# control-plane image — AcpDetector advertises an agent only when the
# binary is on PATH in BOTH places (control-plane for detection, runtime
# for execution).
RUN npm install -g @openai/codex @anthropic-ai/claude-code 2>&1 | tail -5 || true

USER aionui
WORKDIR /workspace

# Run tini as PID 1 so signals propagate and zombies are reaped.
ENTRYPOINT ["/usr/bin/tini", "--", "aionui-entrypoint"]

# Default command: sleep forever — control-plane attaches via `docker exec`
# to run individual agent processes and workers.
CMD ["sleep", "infinity"]
